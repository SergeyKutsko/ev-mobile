require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/react-native-permissions/scripts/setup'

platform :ios, '13.0'

prepare_react_native_project!

ENV['RCT_NEW_ARCH_ENABLED'] = '0'

linkage = ENV['USE_FRAMEWORKS']
if linkage && !linkage.empty?
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'eMobility' do
  config = { reactNativePath: "../node_modules/react-native" }

  setup_permissions([
    'Camera',
    'LocationWhenInUse',
    'BluetoothPeripheral',
    'Contacts',
    'Notifications',
  ])

  puts "🔹 Config result: #{config.inspect}"
  # 📌 Додаткові бібліотеки
  pod 'react-native-permissions', :path => '../node_modules/react-native-permissions'
  pod 'react-native-vision-camera', :path => '../node_modules/react-native-vision-camera'
  # pod 'react-native-bluetooth-status', :path => '../node_modules/react-native-bluetooth-status'
  pod 'react-native-contacts', :path => File.join(__dir__, '../node_modules/react-native-contacts')
  pod 'react-native-community/geolocation', :path => '../node_modules/@react-native-community/geolocation'
  pod 'react-native-push-notification', :path => '../node_modules/react-native-push-notification'
  pod 'react-native-maps', path: '../node_modules/react-native-maps'


  # 🔹 Налаштування React Native
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => false,
    :fabric_enabled => false
  )

  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath])

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
        if target.respond_to?(:product_type) && target.product_type == "com.apple.product-type.bundle"
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end
  end
end
